```groovy
pipeline {
    agent any

    parameters {
        string(
            name: 'DEPLOY_DIR',
            defaultValue: '/var/www/frontend',
            description: 'Frontend deployment directory'
        )
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Pull Images') {
            steps {
                sh '''
                    docker pull ahmedmohmed/frontend_devops:latest
                    docker pull ahmedmohmed/backend_devops:latest
                '''
            }
        }

        stage('Start SQL Server') {
            steps {
                sh '''
                    docker compose -p devops-project up -d sqlserver
                '''
            }
        }

        stage('Deploy Backend') {
            steps {
                sh '''
                    docker compose -p devops-project up -d --no-build backend
                '''
            }
        }

        stage('Deploy Frontend') {
            steps {
                sh '''
                    set -eu

                    deploy_dir="${DEPLOY_DIR:-/var/www/frontend}"
                    container_id=$(docker create \
                        ahmedmohmed/frontend_devops:latest)

                    trap 'docker rm -f "$container_id" >/dev/null 2>&1 || true' EXIT

                    sudo mkdir -p "$deploy_dir"
                    sudo docker cp \
                        "$container_id":/usr/share/nginx/html/. \
                        "$deploy_dir"/
                '''
            }
        }

        stage('Verify') {
            steps {
                sh '''
                    docker compose -p devops-project ps
                    sudo test -f "${DEPLOY_DIR:-/var/www/frontend}/index.html"
                '''
            }
        }
    }

    post {
        always {
            echo "CD pipeline finished: ${currentBuild.currentResult}"
        }
    }
}
```
