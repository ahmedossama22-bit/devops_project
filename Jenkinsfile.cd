pipeline {
    agent any

    parameters {
        string(
            name: 'DEPLOY_DIR',
            defaultValue: '/var/www/frontend',
            description: 'Directory served by the host Nginx'
        )
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Pull Images') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKERHUB_USERNAME',
                    passwordVariable: 'DOCKERHUB_PASSWORD'
                )]) {
                    sh '''
                        set -eu
                        export DOCKER_CONFIG="$(mktemp -d)"
                        trap 'rm -rf "$DOCKER_CONFIG"' EXIT

                        printf '%s' "$DOCKERHUB_PASSWORD" | docker login --username "$DOCKERHUB_USERNAME" --password-stdin
                        docker pull ahmedmohmed/backend_devops:latest
                        docker pull ahmedmohmed/frontend_devops:latest
                        docker tag ahmedmohmed/backend_devops:latest devops-ci-backend:latest
                        docker tag ahmedmohmed/frontend_devops:latest devops-ci-frontend:latest
                    '''
                }
            }
        }

        stage('Deploy Application') {
            steps {
                sh '''
                    set -eu
                    docker compose -p devops-project up -d --no-build sqlserver backend
                    mkdir -p dist
                    docker compose -p devops-project run --rm --no-deps frontend

                    deploy_dir="${DEPLOY_DIR:-/var/www/frontend}"
                    docker run --rm --entrypoint /bin/sh \
                        -v "$WORKSPACE/dist:/src:ro" \
                        -v "$deploy_dir:/dest" \
                        devops-ci-frontend:latest \
                        -c 'cp -R /src/. /dest/'
                '''
                archiveArtifacts artifacts: 'dist/**', fingerprint: true
            }
        }
    }

    post {
        always {
            echo "CD pipeline finished: ${currentBuild.currentResult}"
        }
    }
}
