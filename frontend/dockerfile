FROM node:20-alpine AS build

WORKDIR /app
COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build -- --configuration production

# When container runs, it copies the generated static files (index.html, JS, CSS)
# to the mounted volume at /export and exits cleanly.
CMD ["sh", "-c", "cp -rf /app/dist/frontend/browser/* /export/ && echo 'Frontend build output copied to /export'"]
